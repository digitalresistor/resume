FROM ubuntu:24.04

# Every package is named explicitly and --no-install-recommends is set, so the
# build can never silently depend on something APT decided to add for us.
#
# This matters: the previous version of this file named four packages and
# relied, invisibly, on apt pulling texlive-latex-extra in as a *Recommends* of
# texlive-fonts-extra -- which was the only reason moderncv.cls was ever
# present. Adding --no-install-recommends, ordinary Dockerfile hygiene, would
# have broken the resume build with no hint in this file as to why.
#
#   texlive-binaries             pdftex itself
#   texlive-base                 glyphtounicode.tex, pdflatex.ini
#   texlive-latex-base           fontenc, inputenc, geometry, hyperref, psnfss
#   texlive-latex-recommended    etoolbox (hyperref requires it), microtype
#   texlive-latex-extra          fontaxes, required by noto-sans
#   texlive-fonts-recommended    Nimbus Mono Type1 outlines
#   texlive-fonts-extra          Noto Sans (see the font note in Resume.tex)
#   ghostscript, poppler-utils   the two text extractors ats_check.py compares
#   python3                      ats_check.py and resume_lint.py. Not
#                                python3-minimal: that omits chunks of the
#                                standard library, including html and zlib,
#                                which ats_check.py needs to parse the PDF.
#
# texlive-fonts-extra is the expensive one here (614 MB download) and exists
# solely to supply Noto Sans. If image size ever matters more than the
# typeface, switching Resume.tex to helvet drops it entirely.
#
# texlive-latex-extra is here ONLY for fontaxes, which noto-sans requires.
# titlesec and enumitem are still hand-rolled in Resume.tex rather than taken
# from it, so dropping Noto Sans would drop this package too.
#
# Deliberately absent: texlive-formats-extra (pdflatex.ini
# lives in texlive-base and the format is generated by texlive-latex-base's
# postinst, so it was never needed for -fmt=pdflatex).
RUN apt-get update && \
    env DEBIAN_FRONTEND=noninteractive TZ="America/Los_Angeles" \
    apt-get install -y --no-install-recommends \
        texlive-binaries \
        texlive-base \
        texlive-latex-base \
        texlive-latex-recommended \
        texlive-latex-extra \
        texlive-fonts-recommended \
        texlive-fonts-extra \
        ghostscript \
        poppler-utils \
        python3 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /data
